# ==============================================================================
# Weather Big Data Analytics - Backend Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# Never commit .env with real credentials into version control.
# ==============================================================================

# Application environment: development | test | production
ENVIRONMENT=development

# Database connections (psycopg 3 driver: postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weather_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weather_test

# JWT Authentication
# In production, must be at least 32 characters and NOT match this placeholder.
JWT_SECRET=change_this_to_a_secure_random_32_character_string_at_least
JWT_ISSUER=weather-bda
JWT_AUDIENCE=weather-bda-api
ACCESS_TOKEN_TTL_MINUTES=30

# CORS settings: comma-separated list of allowed origins (no wildcards)
CORS_ORIGINS=http://localhost:5173

# IP Privacy & Abuse Prevention
IP_HASH_SECRET=change_this_to_a_random_secret_for_hmac_ip_hashing

# API Documentation: Swagger & Redoc enabled
API_DOCS_ENABLED=true

# Reverse proxy support: comma-separated IP list
TRUSTED_PROXY_IPS=

# SSRF Protection: Allowed outbound source hostnames
ALLOWED_SOURCE_HOSTS=api.open-meteo.com,api.data.gov.in,mausam.imd.gov.in

# Ingestion Engine & Worker
INGESTION_ENABLED=false
INGESTION_RUN_TIMEOUT_SECONDS=900
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=15.0
HTTP_MAX_RETRIES=3
HTTP_MAX_RESPONSE_BYTES=5242880

# Provider Defaults
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_PAST_DAYS=2
DATA_GOV_IN_API_KEY=

# Rate Limits (SlowAPI string format)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REPORT_SUBMIT=5/hour
RATE_LIMIT_PUBLIC_READ=120/minute
RATE_LIMIT_TRACKING=20/minute

# Account Lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Citizen Reports
REPORT_LOCATION_RADIUS_KM=50.0
REPORT_MAX_AGE_DAYS=30

# Logging
LOG_LEVEL=INFO
